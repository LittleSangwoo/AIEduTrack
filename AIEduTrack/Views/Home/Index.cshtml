@{
    ViewData["Title"] = "AI-EduTrack";
}

<style>
    :root {
        --bg-deep: #0a0e1a;
        --bg-panel: #141c2e;
        --border-soft: rgba(148, 163, 184, 0.14);
        --accent: #3b82f6;
        --accent-bright: #60a5fa;
        --text-primary: #f1f5f9;
        --text-secondary: #b6c2d9;
        --radius-lg: 16px;
    }

    html, body {
        color-scheme: dark;
    }

    body {
        background:
            radial-gradient(circle at 12% 0%, rgba(59, 130, 246, 0.10), transparent 42%),
            radial-gradient(circle at 88% 8%, rgba(34, 197, 94, 0.06), transparent 40%),
            var(--bg-deep);
        color: var(--text-primary);
        font-family: 'Segoe UI', Inter, Roboto, sans-serif;
        min-height: 100vh;
    }

    .role-screen {
        min-height: 75vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px;
    }
    .role-title {
        color: var(--text-primary);
        font-weight: 700;
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }
    .role-subtitle {
        color: var(--text-secondary);
        margin-bottom: 3rem;
    }
    .role-cards {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .role-card {
        width: 280px;
        padding: 32px 24px;
        background: var(--bg-panel);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius-lg);
        text-decoration: none;
        transition: all 0.25s ease;
        cursor: pointer;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }
    .role-card:hover {
        border-color: var(--accent);
        box-shadow: 0 0 25px rgba(59, 130, 246, 0.25);
        transform: translateY(-4px);
    }
    .role-card .icon {
        font-size: 2.5rem;
        margin-bottom: 12px;
    }
    .role-card h5 {
        color: var(--text-primary);
        font-weight: 700;
        margin-bottom: 8px;
    }
    .role-card p {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 0;
    }
</style>

<div class="role-screen">
    <div class="role-title"><i class="bi bi-robot text-primary"></i> AI-EduTrack</div>
    <div class="role-subtitle">Выберите режим работы</div>

    <div class="role-cards">
        <a class="role-card" asp-controller="Methodist" asp-action="Index">
            <div class="icon">🗂️</div>
            <h5>Я методист</h5>
            <p>Загрузка данных, конструктор траекторий, аналитика по всем сотрудникам, настройка ИИ-провайдеров</p>
        </a>

        <a class="role-card" asp-controller="Ggs" asp-action="Index">
            <div class="icon">🧑‍💼</div>
            <h5>Я ГГС (государственный гражданский служащий)</h5>
            <p>Получить свою индивидуальную траекторию обучения по вашему ID или должности</p>
        </a>
    </div>
</div>