@{
    ViewData["Title"] = "AI-EduTrack";
}

<style>
    .role-screen {
        min-height: 80vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }
    .role-title {
        color: #f1f5f9;
        font-weight: 700;
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }
    .role-subtitle {
        color: #94a3b8;
        margin-bottom: 3rem;
    }
    .role-cards {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .role-card {
        width: 280px;
        padding: 32px 24px;
        background: #141c2e;
        border: 1px solid rgba(148, 163, 184, 0.14);
        border-radius: 16px;
        text-decoration: none;
        transition: all 0.25s ease;
        cursor: pointer;
    }
    .role-card:hover {
        border-color: #3b82f6;
        box-shadow: 0 0 25px rgba(59, 130, 246, 0.25);
        transform: translateY(-4px);
    }
    .role-card .icon {
        font-size: 2.5rem;
        margin-bottom: 12px;
    }
    .role-card h5 {
        color: #f1f5f9;
        font-weight: 700;
        margin-bottom: 8px;
    }
    .role-card p {
        color: #94a3b8;
        font-size: 0.9rem;
        margin: 0;
    }
</style>

<div class="role-screen">
    <div class="role-title"><i class="bi bi-robot text-primary"></i> AI-EduTrack</div>
    <div class="role-subtitle">Выберите режим работы</div>

    <div class="role-cards">
        <a class="role-card" asp-controller="Methodist" asp-action="Index">
            <div class="icon">🗂️</div>
            <h5>Я методист</h5>
            <p>Загрузка данных, конструктор траекторий, аналитика по всем сотрудникам, настройка ИИ-провайдеров</p>
        </a>

        <a class="role-card" asp-controller="Ggs" asp-action="Index">
    <div class="icon">🧑‍💼</div>
    <h5>Я ГГС (государственный гражданский служащий)</h5>
    <p>Получить свою индивидуальную траекторию обучения по вашему ID или должности</p>
</a>
    </div>
</div>