@{
    ViewData["Title"] = "Конструктор траектории";
}

<style>
    /* Глобальные переменные темной темы */
    body {
        background-color: #0f172a; /* Глубокий синий/сланцевый цвет */
        color: #e2e8f0;
        font-family: 'Segoe UI', Inter, Roboto, sans-serif;
    }

    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    }

    .section-title {
        color: #f8fafc;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    /* Инпуты и Селекты */
    .dark-input {
        background-color: #0f172a;
        border: 1px solid #334155;
        color: #e2e8f0;
        border-radius: 8px;
    }
    .dark-input:focus {
        background-color: #0f172a;
        color: #fff;
        border-color: #3b82f6;
        box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25);
    }

    /* Карточка профиля */
    .profile-card {
        background: linear-gradient(145deg, #1e293b, #0f172a);
        border-left: 4px solid #3b82f6;
        border-radius: 8px;
        animation: slideDown 0.4s ease forwards;
    }

    /* Радиокнопки выбора движка */
    .engine-option input {
        display: none;
    }
    .engine-card {
        display: flex;
        align-items: center;
        padding: 12px 16px;
        background: #1e293b;
        border: 2px solid transparent;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .engine-option input:checked + .engine-card {
        border-color: #3b82f6;
        background: rgba(59, 130, 246, 0.1);
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.2);
    }
    .engine-card:hover {
        transform: translateY(-2px);
        background: #27354f;
    }

    /* Неоновая кнопка */
    .btn-glow {
        background: linear-gradient(90deg, #2563eb, #3b82f6);
        color: white;
        border: none;
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    .btn-glow:hover:not(:disabled) {
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.6);
        transform: translateY(-2px);
        color: white;
    }
    .btn-glow:disabled {
        background: #334155;
        color: #94a3b8;
    }

    /* Таймлайн (Интерактивная цепочка) */
    .timeline-container {
        position: relative;
        padding-left: 30px;
        margin-top: 20px;
    }
    .timeline-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 8px;
        height: 100%;
        width: 2px;
        background: #334155;
    }
    .timeline-item {
        position: relative;
        margin-bottom: 2rem;
        animation: fadeInRight 0.5s ease forwards;
        opacity: 0;
    }
    .timeline-marker {
        position: absolute;
        left: -30px;
        top: 6px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #0f172a;
        border: 3px solid #3b82f6;
        box-shadow: 0 0 10px rgba(59, 130, 246, 0.8);
        z-index: 1;
    }
    .course-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 16px;
        transition: all 0.3s ease;
    }
    .course-card:hover {
        border-color: #60a5fa;
        box-shadow: 0 8px 25px rgba(0,0,0, 0.2);
    }
    .justification-block {
        background: rgba(15, 23, 42, 0.5);
        border-left: 3px solid #10b981;
        padding: 10px 15px;
        border-radius: 0 8px 8px 0;
        font-size: 0.9rem;
        color: #cbd5e1;
    }

    /* Анимации */
    @@keyframes slideDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes fadeInRight {
        from { opacity: 0; transform: translateX(20px); }
        to { opacity: 1; transform: translateX(0); }
    }
    .fade-pulse {
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0% { opacity: 0.6; }
        50% { opacity: 1; }
        100% { opacity: 0.6; }
    }
</style>

<div class="dark-dashboard container-fluid py-4">
    <div class="row g-4">
        
        <!-- ЛЕВАЯ ПАНЕЛЬ: Настройки и профиль -->
        <div class="col-lg-4">
            <div class="glass-panel p-4 mb-4">
                <h4 class="section-title mb-4"><i class="bi bi-person-badge"></i> Выбор сотрудника</h4>
                
                <div class="mb-3">
                    <label class="form-label text-muted">ID или ФИО ГГС</label>
                    <select class="form-select dark-input" id="employeeSelect">
                        <option value="" selected disabled>Выберите сотрудника...</option>
                        <option value="1">Иванов Иван Иванович (ID: 1042)</option>
                        <option value="2">Смирнова Анна Сергеевна (ID: 2011)</option>
                    </select>
                </div>

                <!-- Карточка профиля (скрыта до выбора) -->
                <div id="profileCard" class="profile-card p-3 d-none">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary">Специалист</span>
                        <small class="text-muted">Комитет по информатизации</small>
                    </div>
                    <p class="mb-1 text-light fw-bold">Пройденные курсы:</p>
                    <ul class="text-muted small ps-3 mb-0">
                        <li>Основы госслужбы (ППК)</li>
                        <li>Тайм-менеджмент (ЭК)</li>
                    </ul>
                </div>
            </div>

            <!-- Блок управления данными (Для администратора) -->
<div class="glass-panel p-4 mb-4 border-primary border-opacity-25">
    <h4 class="section-title mb-4 fs-5"><i class="bi bi-cloud-arrow-up"></i> Обновление базы данных</h4>
    
    <form id="uploadDataForm" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label text-muted small">История обучения ГГС (.xlsx)</label>
            <input class="form-control dark-input form-control-sm" type="file" id="historyFile" accept=".xlsx, .csv">
        </div>
        <div class="mb-3">
            <label class="form-label text-muted small">Реестр курсов (.xlsx)</label>
            <input class="form-control dark-input form-control-sm" type="file" id="catalogFile" accept=".xlsx, .csv">
        </div>
        <button type="button" id="uploadFilesBtn" class="btn btn-outline-info btn-sm w-100">
            <i class="bi bi-database-add"></i> Загрузить и обновить БД
        </button>
    </form>
</div>

            <div class="glass-panel p-4">
                <h4 class="section-title mb-4"><i class="bi bi-cpu"></i> Выбор ИИ-движка</h4>
                
                <div class="engine-selector">
                    <label class="engine-option">
                        <input type="radio" name="llmEngine" value="russian" checked>
                        <div class="engine-card">
                            <span class="fs-4">🇷🇺</span>
                            <div class="ms-3">
                                <h6 class="mb-0 text-light">GigaChat / YandexGPT</h6>
                                <small class="text-muted">Отечественные модели</small>
                            </div>
                        </div>
                    </label>

                    <label class="engine-option mt-3">
                        <input type="radio" name="llmEngine" value="foreign">
                        <div class="engine-card">
                            <span class="fs-4">🌐</span>
                            <div class="ms-3">
                                <h6 class="mb-0 text-light">Groq (Llama 3 70B)</h6>
                                <small class="text-muted">Зарубежные модели (Высокая скорость)</small>
                            </div>
                        </div>
                    </label>

                    <label class="engine-option mt-3">
                        <input type="radio" name="llmEngine" value="local">
                        <div class="engine-card">
                            <span class="fs-4">💻</span>
                            <div class="ms-3">
                                <h6 class="mb-0 text-light">Ollama Local</h6>
                                <small class="text-muted">Локальный инференс (Llama 3 8B)</small>
                            </div>
                        </div>
                    </label>
                </div>

                <button id="generateBtn" class="btn btn-glow w-100 mt-4 py-2 fw-bold" disabled>
                    Сформировать траекторию
                </button>
            </div>
        </div>

        <!-- ПРАВАЯ ПАНЕЛЬ: Интерактивная траектория -->
        <div class="col-lg-8">
            <div class="glass-panel p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="section-title mb-0"><i class="bi bi-map"></i> Индивидуальный маршрут</h4>
                    <span id="generationStatus" class="badge bg-success d-none fade-in">Сгенерировано за 2.4 сек</span>
                </div>

                <!-- Состояние пустого экрана -->
                <div id="emptyState" class="text-center text-muted py-5 mt-5">
                    <div class="fs-1 mb-3">🌌</div>
                    <h5>Траектория не сформирована</h5>
                    <p>Выберите сотрудника и ИИ-движок для начала работы</p>
                </div>

                <!-- Лоадер -->
                <div id="loader" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
                    <p class="mt-3 text-light fade-pulse">Нейросеть анализирует дефицит компетенций...</p>
                </div>

                <!-- Контейнер таймлайна -->
                <div id="trajectoryTimeline" class="timeline-container d-none">
                    <!-- Шаги будут добавляться сюда через JS -->
                </div>
            </div>
        </div>
    </div>
</div>

                    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const employeeSelect = document.getElementById('employeeSelect');
        const profileCard = document.getElementById('profileCard');
        const generateBtn = document.getElementById('generateBtn');
        
        const emptyState = document.getElementById('emptyState');
        const loader = document.getElementById('loader');
        const trajectoryTimeline = document.getElementById('trajectoryTimeline');
        const generationStatus = document.getElementById('generationStatus');

        // Включение тултипов Bootstrap
        function initTooltips() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        // Выбор сотрудника
        employeeSelect.addEventListener('change', function () {
            if (this.value) {
                profileCard.classList.remove('d-none');
                generateBtn.disabled = false;
            }
        });

        // Нажатие на генерацию
        generateBtn.addEventListener('click', function () {
            // 1. Показываем лоадер, прячем старое
            emptyState.classList.add('d-none');
            trajectoryTimeline.classList.add('d-none');
            generationStatus.classList.add('d-none');
            trajectoryTimeline.innerHTML = ''; // Очистка старой траектории
            loader.classList.remove('d-none');
            generateBtn.disabled = true;

            // Имитация запроса к бэкенду (Модулю 1) на 2 секунды
            setTimeout(() => {
                loader.classList.add('d-none');
                
                // Рендер тестовых DTO-данных
                renderTrajectory(mockTrajectoryData);
                
                generationStatus.classList.remove('d-none');
                generateBtn.disabled = false;
            }, 2000);
        });

        // Функция отрисовки шагов маршрута
        function renderTrajectory(steps) {
            steps.forEach((step, index) => {
                // Задержка анимации для каждого шага каскадом
                const delay = index * 0.2; 
                
                const stepHtml = `
                    <div class="timeline-item" style="animation-delay: ${delay}s">
                        <div class="timeline-marker"></div>
                        <div class="course-card" data-bs-toggle="tooltip" data-bs-placement="top" 
                             title="Развиваемые навыки: ${step.TargetCompetencies.join(', ')}">
                            <div class="d-flex justify-content-between">
                                <h5 class="text-white mb-1">
                                    <span class="text-primary me-2">${step.Order}.</span> ${step.CourseName}
                                </h5>
                                <span class="badge bg-secondary">${step.CourseType}</span>
                            </div>
                            <p class="text-muted small mb-3">${step.ShortDescription}</p>
                            
                            <div class="justification-block mt-2">
                                <strong><i class="bi bi-robot"></i> Почему рекомендовано:</strong><br/>
                                ${step.Justification}
                            </div>
                        </div>
                    </div>
                `;
                trajectoryTimeline.insertAdjacentHTML('beforeend', stepHtml);
            });
            
            trajectoryTimeline.classList.remove('d-none');
            initTooltips(); // Активируем тултипы для новых элементов
        }

        // Мок-данные (те, что будут приходить из TrajectoryResultDto)
        const mockTrajectoryData = [
            {
                Order: 1,
                CourseName: "Основы противодействия коррупции",
                CourseType: "ЭК",
                ShortDescription: "Базовый электронный курс по нормативной базе.",
                TargetCompetencies: ["Правовая грамотность", "Соблюдение регламентов"],
                Justification: "Сотрудник недавно вступил в должность в Комитете. Анализ коллег показывает, что этот надпрофессиональный навык критичен для начала работы."
            },
            {
                Order: 2,
                CourseName: "Управление гос. закупками (44-ФЗ)",
                CourseType: "ППК",
                ShortDescription: "Углубленная программа повышения квалификации.",
                TargetCompetencies: ["Управление закупками", "Аналитика", "Документооборот"],
                Justification: "В профиле указана роль 'Специалист по закупкам', однако история обучения показывает отсутствие профильных ППК. Модель рекомендует закрыть этот дефицит."
            }
        ];
    });
</script>