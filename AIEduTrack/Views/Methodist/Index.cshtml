@model List<AIEduTrack.Models.LlmProviderConfig>
@{
    ViewData["Title"] = "Конструктор траектории";
}

<style>

    /* Карточка профиля */
    .profile-card {
        background: linear-gradient(145deg, var(--bg-panel-2), var(--bg-panel));
        border: 1px solid var(--border-soft);
        border-left: 4px solid var(--accent);
        border-radius: var(--radius-sm);
        animation: slideDown 0.4s ease forwards;
    }
    .profile-card .badge {
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    /* Радиокнопки выбора движка */
    .engine-option input {
        display: none;
    }
    .engine-card {
        display: flex;
        align-items: center;
        padding: 12px 16px;
        background: var(--bg-panel-2);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }
    .engine-option input:checked + .engine-card {
        border-color: var(--accent);
        background: var(--accent-soft);
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.25);
    }
    .engine-card:hover {
        border-color: var(--border-strong);
    }
    .engine-card h6 {
        color: var(--text-primary);
    }

    /* Кнопка запуска генерации */
    .btn-glow {
        background: linear-gradient(90deg, #2563eb, #3b82f6);
        color: #fff;
        border: none;
        border-radius: var(--radius-sm);
        transition: all 0.3s ease;
        letter-spacing: 0.3px;
    }
    .btn-glow:hover:not(:disabled) {
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.55);
        transform: translateY(-2px);
        color: #fff;
    }
    .btn-glow:disabled {
        background: #26314a;
        color: #64748b;
    }

    /* Кнопка загрузки данных */
    .btn-outline-custom {
        background: transparent;
        border: 1px solid var(--border-strong);
        color: var(--text-secondary);
        border-radius: var(--radius-sm);
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .btn-outline-custom:hover {
        border-color: var(--accent-bright);
        background: var(--accent-soft);
        color: #fff;
    }
    /* Стилизация нативного input[type=file] — под тот же вид, что и .dark-input */
    .dark-input[type="file"] {
        padding: 8px 12px;
    }

        .dark-input[type="file"]::file-selector-button {
            background: var(--bg-panel-2);
            color: var(--text-primary);
            border: 1px solid var(--border-strong);
            border-radius: 6px;
            padding: 6px 14px;
            font-size: 0.82rem;
            font-weight: 600;
            margin-right: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .dark-input[type="file"]::file-selector-button:hover {
                border-color: var(--accent-bright);
                background: var(--accent-soft);
            }

    /* Таймлайн траектории */
    .timeline-container {
        position: relative;
        padding-left: 28px;
    }
    .timeline-container::before {
        content: "";
        position: absolute;
        left: 9px;
        top: 6px;
        bottom: 6px;
        width: 2px;
        background: linear-gradient(to bottom, var(--accent), rgba(59, 130, 246, 0.05));
    }
    .timeline-item {
        position: relative;
        margin-bottom: 1.25rem;
        opacity: 0;
        animation: fadeInRight 0.5s ease forwards;
    }
    .timeline-item:last-child {
        margin-bottom: 0;
    }
    .timeline-marker {
        position: absolute;
        left: -28px;
        top: 18px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--accent-bright);
        box-shadow: 0 0 0 4px var(--bg-deep), 0 0 12px rgba(96, 165, 250, 0.7);
    }
    .profile-card .badge {
    white-space: normal;
    word-break: break-word;
    text-align: left;
    line-height: 1.4;
    display: inline-block;
    max-width: 100%;
}
    /* Карточки курсов в таймлайне */
    .course-card {
        background: var(--bg-panel-2);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius-md);
        padding: 18px;
        transition: all 0.3s ease;
    }

        .course-card:hover {
            border-color: var(--accent-bright);
            background: var(--card-hover-bg);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        }
    .course-card h5 {
        color: var(--text-primary);
        font-size: 1.05rem;
    }
    .course-card p {
        color: var(--text-secondary);
    }

    .justification-block {
        background: var(--bg-panel-2);
        border-left: 3px solid var(--success);
        padding: 12px 15px;
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        font-size: 0.92rem;
        color: var(--text-secondary);
        line-height: 1.5;
    }

        .justification-block strong {
            color: var(--success);
        }

    /* Пустое состояние и лоадер */
    #emptyState {
        color: var(--text-tertiary);
    }
    #emptyState h5 {
        color: var(--text-secondary);
        font-weight: 600;
    }

    /* Анимации */
    @@keyframes slideDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes fadeInRight {
        from { opacity: 0; transform: translateX(20px); }
        to { opacity: 1; transform: translateX(0); }
    }
    .fade-pulse {
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0% { opacity: 0.6; }
        50% { opacity: 1; }
        100% { opacity: 0.6; }
    }
    /* Toast-уведомление вместо alert() */
    .toast-notify {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 9999;
        min-width: 320px;
        max-width: 420px;
        background: var(--bg-panel);
        border: 1px solid var(--border-strong);
        border-left: 4px solid var(--accent);
        border-radius: var(--radius-md);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
        padding: 16px 18px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        transform: translateX(120%);
        opacity: 0;
        transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

        .toast-notify.show {
            transform: translateX(0);
            opacity: 1;
        }

        .toast-notify.toast-error {
            border-left-color: #ef4444;
        }

        .toast-notify .toast-icon {
            font-size: 1.4rem;
            flex-shrink: 0;
            color: var(--success);
        }

        .toast-notify.toast-error .toast-icon {
            color: #f87171;
        }

        .toast-notify .toast-body {
            flex-grow: 1;
            color: var(--text-primary);
            font-size: 0.9rem;
            line-height: 1.4;
        }

        .toast-notify .toast-title {
            font-weight: 700;
            margin-bottom: 2px;
            display: block;
        }

        .toast-notify .toast-close {
            cursor: pointer;
            color: var(--text-tertiary);
            font-size: 1.1rem;
            line-height: 1;
            background: none;
            border: none;
            padding: 0;
        }

            .toast-notify .toast-close:hover {
                color: var(--text-primary);
            }
</style>

<div class="dark-dashboard container-fluid py-4">
    <div class="page-header">
        <div class="eyebrow">AIEduTrack</div>
        <h1>Конструктор траектории</h1>
        <p>Формирование индивидуального плана обучения на основе профиля ггс и дефицита компетенций</p>
    </div>
    <div class="row g-4">
        
        <!-- ЛЕВАЯ ПАНЕЛЬ: Настройки и профиль -->
        <div class="col-lg-4">
            <div class="glass-panel p-4 mb-4">
                <h4 class="section-title mb-4"><i class="bi bi-person-badge"></i> Выбор ГГС</h4>

                <div class="mb-3">
                    <label class="form-label">ID сотрудника</label>
                    <select class="form-select dark-input" id="employeeSelect">
                        <option value="" selected disabled>Выберите ГГС...</option>
                    </select>
                    <small id="usersCountHint" class="text-muted-custom d-block mt-1" style="font-size: 0.75rem;"></small>
                </div>

                <!-- Карточка профиля (скрыта до выбора), заполняется реальными данными из JS -->
                <div id="profileCard" class="profile-card p-3 d-none">
                    <div class="mb-2">
                        <span id="profileRole" class="badge bg-primary">—</span>
                        <div id="profileDepartment" class="text-muted-custom mt-1" style="font-size: 0.82rem;">—</div>
                    </div>
                    <p class="mb-1 fw-bold">Пройденные курсы: <span id="passedCount" class="text-muted-custom fw-normal"></span></p>
                    <ul id="passedCoursesList" class="text-muted-custom small ps-3 mb-2" style="max-height: 120px; overflow-y: auto;"></ul>
                    <p class="mb-1 fw-bold">Не пройдено: <span id="failedCount" class="text-muted-custom fw-normal"></span></p>
                    <ul id="failedCoursesList" class="text-muted-custom small ps-3 mb-0" style="max-height: 80px; overflow-y: auto;"></ul>
                </div>
            </div>

            <!-- Реальные данные пользователей, переданные из контроллера -->
            <script id="allUsersData" type="application/json">@Html.Raw(ViewBag.AllUsersJson)</script>

            <!-- Блок управления данными (Для администратора) -->
            <div class="glass-panel p-4 mb-4 border-primary border-opacity-25">
                <h4 class="section-title mb-4 fs-5"><i class="bi bi-cloud-arrow-up"></i> Обновление данных</h4>

                <form id="uploadDataForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label small">История обучения ГГС (.xlsx / .csv) *</label>
                        <input class="form-control dark-input form-control-sm" type="file" id="historyFile" accept=".xlsx, .csv">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Реестр электронных курсов (.xlsx / .csv) *</label>
                        <input class="form-control dark-input form-control-sm" type="file" id="catalogFile" accept=".xlsx, .csv">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Буклет программ ППК (.pdf) — необязательно</label>
                        <input class="form-control dark-input form-control-sm" type="file" id="bookletFile" accept=".pdf">
                        <small class="text-muted-custom d-block mt-1" style="font-size: 0.75rem;">
                            Без буклета в каталоге будут только электронные курсы (ЭК), без программ повышения квалификации (ППК)
                        </small>
                    </div>
                    <button type="button" id="uploadFilesBtn" class="btn btn-outline-custom btn-sm w-100">
                        <i class="bi bi-database-add"></i> Загрузить и обновить данные
                    </button>
                </form>
            </div>
            <div class="glass-panel p-4">
                <h4 class="section-title mb-4"><i class="bi bi-cpu"></i> Выбор ИИ-движка</h4>
                
                <div class="engine-selector">
                    @foreach (var provider in Model)
                    {
                        // Определяем иконку по типу
                        string icon = provider.IsLocal ? "💻" : (provider.AuthType == "GigaChat" ? "🇷🇺" : "🌐");
                        // Делаем первый элемент выбранным по умолчанию
                        string isChecked = provider == Model.First() ? "checked" : "";

                        <label class="engine-option mb-3 d-block">
                            <!-- В value передаем Name провайдера (например, "ollama local1") -->
                            <input type="radio" name="llmEngine" value="@provider.Name" @isChecked>
                            <div class="engine-card">
                                <span class="fs-4">@icon</span>
                                <div class="ms-3">
                                    <h6 class="mb-0 fw-bold">@provider.Name</h6>
                                    <small class="text-muted-custom">@provider.Model (@provider.AuthType)</small>
                                </div>
                            </div>
                        </label>
                    }
                </div>

                <button id="generateBtn" class="btn btn-glow w-100 mt-4 py-2 fw-bold" disabled>
                    Сформировать траекторию
                </button>
            </div>
        </div>

        <!-- ПРАВАЯ ПАНЕЛЬ: Интерактивная траектория -->
        <div class="col-lg-8">
            <div class="glass-panel p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="section-title mb-0"><i class="bi bi-map"></i> Индивидуальный маршрут</h4>
                    <span id="generationStatus" class="badge bg-success d-none fade-in">Сгенерировано за 2.4 сек</span>
                </div>
                <div id="exportButtons" class="d-flex gap-2 mb-4 flex-wrap d-none">
                    <button class="export-btn export-btn-excel" onclick="exportTrajectory('excel')">
                        <i class="bi bi-file-earmark-excel"></i> Excel
                    </button>
                    <button class="export-btn export-btn-word" onclick="exportTrajectory('word')">
                        <i class="bi bi-file-earmark-word"></i> Word
                    </button>
                    <button class="export-btn export-btn-json" onclick="exportTrajectory('json')">
                        <i class="bi bi-filetype-json"></i> JSON
                    </button>
                </div>

                <!-- Состояние пустого экрана -->
                <div id="emptyState" class="text-center py-5 mt-5">
                    <div class="fs-1 mb-3">🌌</div>
                    <h5>Траектория не сформирована</h5>
                    <p>Выберите гсс и ИИ-движок для начала работы</p>
                </div>

                <!-- Лоадер -->
                <div id="loader" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
                    <p class="mt-3 text-light fade-pulse">Нейросеть анализирует дефицит компетенций...</p>
                </div>

                <!-- Контейнер таймлайна -->
                <div id="trajectoryTimeline" class="timeline-container d-none">
                    <!-- Шаги будут добавляться сюда через JS -->
                </div>
            </div>
        </div>
    </div>
</div>

                    <script>
                            function showToast(message, isError = false) {
        const existing = document.querySelector('.toast-notify');
        if (existing) existing.remove();

        const toast = document.createElement('div');
        toast.className = `toast-notify ${isError ? 'toast-error' : ''}`;
        toast.innerHTML = `
            <div class="toast-icon"><i class="bi ${isError ? 'bi-x-circle-fill' : 'bi-check-circle-fill'}"></i></div>
            <div class="toast-body">
                <span class="toast-title">${isError ? 'Ошибка' : 'Готово'}</span>
                ${message}
            </div>
            <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
        `;
        document.body.appendChild(toast);

        requestAnimationFrame(() => toast.classList.add('show'));

        setTimeout(() => {
            toast.classList.remove('show');
            setTimeout(() => toast.remove(), 350);
        }, 5000);
    }
    document.addEventListener("DOMContentLoaded", function () {
        const employeeSelect = document.getElementById('employeeSelect');
        const profileCard = document.getElementById('profileCard');
        const generateBtn = document.getElementById('generateBtn');
        
        const emptyState = document.getElementById('emptyState');
        const loader = document.getElementById('loader');
        const trajectoryTimeline = document.getElementById('trajectoryTimeline');
        const generationStatus = document.getElementById('generationStatus');

        const exportButtons = document.getElementById('exportButtons');
        let lastTrajectoryResult = null;

        window.exportTrajectory = async function (format) {
            if (!lastTrajectoryResult) {
                showToast('Сначала сформируйте траекторию.', true);
                return;
            }

            try {
                const response = await fetch(`/Ggs/ExportTrajectory?format=${format}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(lastTrajectoryResult)
                });

                if (!response.ok) throw new Error('Ошибка сервера при формировании файла.');

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;

                const ext = format === 'excel' ? 'xlsx' : format === 'word' ? 'docx' : 'json';
                a.download = `Траектория_${lastTrajectoryResult.userId}.${ext}`;

                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);
            } catch (err) {
                showToast('Ошибка при скачивании: ' + err.message, true);
                console.error(err);
            }
        };

        // Включение тултипов Bootstrap
        function initTooltips() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        // Выбор сотрудника
            // Загружаем реальных пользователей, переданных контроллером
    const allUsersRaw = document.getElementById('allUsersData').textContent;
    const allUsers = allUsersRaw ? JSON.parse(allUsersRaw) : [];

    // Строим список в dropdown
    allUsers.forEach(u => {
        const opt = document.createElement('option');
        opt.value = u.id;
        opt.textContent = `${u.id} (${u.role || 'без должности'})`;
        employeeSelect.appendChild(opt);
    });

    document.getElementById('usersCountHint').textContent =
        allUsers.length > 0 ? `Загружено ${allUsers.length} сотрудников` : 'Данные не загружены — используйте форму ниже';

    const profileRole = document.getElementById('profileRole');
    const profileDepartment = document.getElementById('profileDepartment');
    const passedCount = document.getElementById('passedCount');
    const failedCount = document.getElementById('failedCount');
    const passedCoursesList = document.getElementById('passedCoursesList');
    const failedCoursesList = document.getElementById('failedCoursesList');

    // Выбор сотрудника — заполняем карточку реальными данными
    employeeSelect.addEventListener('change', function () {
        const user = allUsers.find(u => u.id === this.value);
        if (!user) return;

        profileRole.textContent = user.role || 'Должность не указана';
        profileDepartment.textContent = user.department || 'ИОГВ не указан';

        const history = user.learningHistory || [];
        const passed = history.filter(h => h.status === 'Пройден');
        const failed = history.filter(h => h.status !== 'Пройден');

        passedCount.textContent = `(${passed.length})`;
        failedCount.textContent = `(${failed.length})`;

        passedCoursesList.innerHTML = passed.length
            ? passed.map(h => `<li>${h.courseName}</li>`).join('')
            : '<li>Нет данных</li>';

        failedCoursesList.innerHTML = failed.length
            ? failed.map(h => `<li>${h.courseName}</li>`).join('')
            : '<li>Нет</li>';

        profileCard.classList.remove('d-none');
        generateBtn.disabled = false;
    });

        // Нажатие на генерацию
        // Нажатие на генерацию (РЕАЛЬНЫЙ ЗАПРОС К НЕЙРОСЕТЯМ)
        generateBtn.addEventListener('click', function () {
            emptyState.classList.add('d-none');
            trajectoryTimeline.classList.add('d-none');
            generationStatus.classList.add('d-none');
            trajectoryTimeline.innerHTML = ''; 
            loader.classList.remove('d-none');
            generateBtn.disabled = true;

            // Получаем выбранную нейросеть и пользователя
            const selectedEngine = document.querySelector('input[name="llmEngine"]:checked').value;
            const selectedUserId = employeeSelect.value;

            // Отправляем запрос на наш C# бэкенд
            fetch('/Methodist/GenerateTrajectory', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ UserId: selectedUserId, LlmProvider: selectedEngine })
            })
            .then(response => response.json())
            .then(result => {
                loader.classList.add('d-none');
                        if(result.success) {
                        lastTrajectoryResult = result.data;
                        generationStatus.innerText = `Сгенерировано за ${result.data.executionTimeMs / 1000} сек`;
                        renderTrajectory(result.data.steps);
                        generationStatus.classList.remove('d-none');
                        exportButtons.classList.remove('d-none');
                    } else {
    showToast(friendlyErrorMessage(result.message), true, result.message);
}
                
                generateBtn.disabled = false;
            })
            .catch(error => {
                loader.classList.add('d-none');
                alert('Сетевая ошибка при обращении к ИИ.' + error.message);
                generateBtn.disabled = false;
                console.error(error);
            });
        });

        //ВАЖНО ЭТО УБРАТЬ!!
        // Функция отрисовки шагов маршрута
        // function renderTrajectory(steps) {
        //     steps.forEach((step, index) => {
        //         Задержка анимации для каждого шага каскадом
        //         const delay = index * 0.2; 
                
        //         const stepHtml = `
        //             <div class="timeline-item" style="animation-delay: ${delay}s">
        //                 <div class="timeline-marker"></div>
        //                 <div class="course-card" data-bs-toggle="tooltip" data-bs-placement="top" 
        //                      title="Развиваемые навыки: ${step.TargetCompetencies.join(', ')}">
        //                     <div class="d-flex justify-content-between">
        //                         <h5 class="text-white mb-1">
        //                             <span class="text-primary me-2">${step.Order}.</span> ${step.CourseName}
        //                         </h5>
        //                         <span class="badge bg-secondary">${step.CourseType}</span>
        //                     </div>
        //                     <p class="text-muted-custom small mb-3">${step.ShortDescription}</p>
                            
        //                     <div class="justification-block mt-2">
        //                         <strong><i class="bi bi-robot"></i> Почему рекомендовано:</strong><br/>
        //                         ${step.Justification}
        //                     </div>
        //                 </div>
        //             </div>
        //         `;
        //         trajectoryTimeline.insertAdjacentHTML('beforeend', stepHtml);
        //     });
            
        //     trajectoryTimeline.classList.remove('d-none');
        //     initTooltips(); Активируем тултипы для новых элементов
        // }

        function renderTrajectory(steps) {
            const timeline = document.getElementById('trajectoryTimeline');
            if (!timeline) return;
            
            timeline.innerHTML = '';
            
            steps.forEach(step => {
                let compsHtml = '';
                
                // БРОНЕБОЙНАЯ ПРОВЕРКА: смотрим, что именно пришло от C#
                if (Array.isArray(step.targetCompetencies)) {
                    // Если это настоящий массив - перебираем его
                    compsHtml = step.targetCompetencies.map(c => `<span class="badge bg-primary me-1">${c}</span>`).join('');
                } else if (typeof step.targetCompetencies === 'string' && step.targetCompetencies.length > 0) {
                    // Если это просто строка - выводим как один бейдж
                    compsHtml = `<span class="badge bg-primary me-1">${step.targetCompetencies}</span>`;
                }

                timeline.innerHTML += `
                    <div class="course-card mb-3">
                            <h5>${step.courseName || 'Без названия'} <span class="badge bg-secondary ms-2" style="font-size:0.7rem;">${step.courseType || 'ЭК'}</span></h5>
                        <p class="text-muted-custom mb-2">${step.shortDescription || 'Описание отсутствует'}</p>
                        <div class="mb-2">${compsHtml}</div>
                        <div class="justification-block mt-3">
                            🤖 <strong>Обоснование ИИ:</strong> ${step.justification || 'Рекомендовано системой.'}
                        </div>
                    </div>
                `;
            });
            
            timeline.classList.remove('d-none');
        }

        
    });
    // Обработка кнопки "Загрузить и обновить БД"
        // Обработка кнопки "Загрузить и обновить данные"
    const uploadFilesBtn = document.getElementById('uploadFilesBtn');
    if (uploadFilesBtn) {
        uploadFilesBtn.addEventListener('click', function () {
            const historyFile = document.getElementById('historyFile').files[0];
            const catalogFile = document.getElementById('catalogFile').files[0];
            const bookletFile = document.getElementById('bookletFile').files[0]; // необязательно

            if (!historyFile || !catalogFile) {
                alert('Файлы истории обучения и реестра курсов обязательны!');
                return;
            }

            const formData = new FormData();
            formData.append('historyFile', historyFile);
            formData.append('catalogFile', catalogFile);
            if (bookletFile) {
                formData.append('bookletFile', bookletFile);
            }

            const originalText = uploadFilesBtn.innerHTML;
            uploadFilesBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Загрузка и парсинг...';
            uploadFilesBtn.disabled = true;

            fetch('/Methodist/UploadData', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) throw new Error('Ошибка сервера при обработке файлов.');
                return response.json();
            })
                .then(result => {
        showToast(result.message || 'Данные обновлены.');
        setTimeout(() => window.location.reload(), 3500); // даём тосту показаться перед перезагрузкой
    })
    .catch(error => {
        showToast('Ошибка при загрузке: ' + error.message, true);
        console.error(error);
        uploadFilesBtn.innerHTML = originalText;
        uploadFilesBtn.disabled = false;
    });
        });
    }
</script>